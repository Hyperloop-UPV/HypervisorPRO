#define element (type, variable)
#define PARSE_MESSAGE( packet,
                       element1,
                       element2,
                       ...
                       elementn)
offset = 0
for each (packet([size, variable]))
{
    variable1 = message[offset];
    offset += size
}
#undefine packet


