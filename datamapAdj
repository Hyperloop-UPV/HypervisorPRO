//  HVBMS  //
/////////////

> HVBMS :

  - Descripción :

  Esta es la placa encargada de conocer el estado de todas las baterías del pod, y se encarga de administrar
  corriente a todos los componentes del pod. Tiene una máquina de estados que controla la cantidad de corriente
  que pueden recibir los componentes en función del estado.

  El pod tine un total de 8 baterias, compuestas por 12 células cada una.

  [] measurements :

      # contactor :
      {
          - contactor_precharge   : 1 byte (bool)
          - contactor_discharge   : 1 byte (bool)
          - contactor_high        : 1 byte (bool)
          - contactor_low         : 1 byte (bool)
          - contactor_common_high : 1 byte (bool)
      }

      # imd :
      {
          - imd_status : 1 byte (enum)
            [
               SHORTCIRCUIT    : 1
               NORMAL          : 2
               UNDERVOLTAGE    : 3
               FAST_EVAL       : 4
               GROUNDING_FAULT : 5
            ]

          - imd_is_ok      : 1 byte (bool)
          - imd_resistance : 4 bytes (float32) -> "MOhm"
          - imd_duty       : 4 bytes (float32)
          - imd_freq       : 4 bytes (float32)

      }

      # battery [8] :
      {
          - total_battery_volt : 4 bytes (float32) -> "V"
          - cell_volt   [12]   : 4 bytes (float32) -> "V"
          - battery_temp [4]   : 4 bytes (float32)  -> "ºC"
      }

      // máquina de estado general
      - sm_status : 1 byte (enum) :
        [
           Connecting          : 1
           Idle                : 2
           Ready To Precharge  : 3
           Precharging         : 4
           Energized           : 5
           FAULT               : 6
        ]



      // variables de control de rangos

      - voltage_min : 4 bytes (float32) -> "V"
      - voltage_max : 4 bytes (float32) -> "V"
      - temp_min    : 4 bytes (float32) -> "ºC"
      - temp_max    : 4 bytes (float32) -> "ºC"


      // variables de lectura de datos

      - batteries_voltage_reading : 4 bytes (float32) -> "V"
      - voltage_reading : 4 bytes (float32) -> "V"
      - current_reading : 4 bytes (float32) -> "A"

      - sdc_status : 1 byte (enum)
        [
           ENGAGED    : 1
           DISENGAGED : 2
        ]

      - soc : 4 bytes (float32) ??? ni idea de lo que es el soc

  // end of measurements


  [] orders:

      - FAULT             (id 2000) : 8 bytes (uint64)
      - Cell Balance      (id 2001) : 8 bytes (uint64)
      - Open Contractors  (id 2002) : 8 bytes (uint64)
      - Start Precharge   (id 2003) : 8 bytes (uint64)
      - Check Faults      (id 2004) : 8 bytes (uint64)

  // end of orders


  [] packets:

      # high voltage system
      {
          - id      : 2161
          - content : 29 bytes (32 bytes alligned)
            [
                voltage_min                : 4 bytes (float32)
                voltage_max                : 4 bytes (float32)
                temp_min                   : 4 bytes (float32)
                temp_max                   : 4 bytes (float32)
                current_reading            : 4 bytes (float32)
                voltage_reading            : 4 bytes (float32)
                batteries_voltage_reading  : 4 bytes (float32)
                sm_status                  : 1 byte (enum)
            ]

      }

      # high voltage batteries
      {
          - id      : 2164
          - content : 272 bytes -> 68 bytes (per battery)

            [
                battery1_cell1         : 4 bytes (float32)
                battery1_cell2         : 4 bytes (float32)

                ...

                battery1_cell12        : 4 bytes (float32)
                battery1_total_voltage : 4 bytes (float32)
                battery1_temp1         : 4 bytes (float32)

                ...

                battery1_temp4         : 4 bytes (float32)
                battery2_cell1         : 4 bytes (float32)

                ...

                battery1_temp4         : 4 bytes (float32)
            ]

      }

      # SOC
      {
          - id      : 2162
          - content : 4 bytes
            [
                soc : 4 bytes (float32)
            ]
      }

      # SDC
      {
          - id      : 2163
          - content : 1 byte
            [
                sdc_status :  1 byte (enum)
            ]
      }

      # IMD
      {
          - id      : 2165
          - content : 14 bytes (20 bytes alligned)
            [
                imd_status     : 1 byte (enum)
                imd_resistance : 4 bytes (float32)
                imd_is_ok      : 1 byte (bool)
                imd_duty       : 4 bytes (float32)
                imd_freq       : 4 bytes (float32)
            ]
      }

      # contactor status
      {
          - id      : 2166
          - content : 5 bytes
          [
                contactor_discharge   : 1 byte (bool)
                contactor_precharge   : 1 byte (bool)
                contactor_low         : 1 byte (bool)
                contactor_high        : 1 byte (bool)
                contactor_common_high : 1 byte (bool)
          ]
      }


  // end of packets




